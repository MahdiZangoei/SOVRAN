# SOVRAN environment template
# Copy to .env only on a trusted deployment host.
# Never commit the real .env file.

SOVRAN_ENV=development
SOVRAN_LOG_LEVEL=INFO
SOVRAN_BASE_DOMAIN=sovran.digitalclassic.ir
SOVRAN_DASHBOARD_DOMAIN=panel.sovran.digitalclassic.ir

# Bind internal services to loopback or a private container network.
SOVRAN_API_HOST=127.0.0.1
SOVRAN_API_PORT=8000

# Configure secrets through a secure secret manager or protected host file.
# Do not place real values in this template.
SOVRAN_SECRET_KEY=
SOVRAN_DATABASE_URL=
SOVRAN_REDIS_URL=

# Provider configuration is intentionally not populated here.
CODEX_EXECUTABLE=
CODEX_WORKSPACE_ROOT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Backup adapter: configure only after selecting a provider.
BACKUP_PROVIDER=
BACKUP_REPOSITORY=
BACKUP_PASSWORD_FILE=
